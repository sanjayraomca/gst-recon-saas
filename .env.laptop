# =========================================================================
# GST Tool Local Laptop Testing Configuration (Mirrors Production)
# =========================================================================
#
# INSTRUCTIONS FOR LOCAL/PRIVATE TESTING:
# 1. Copy this file to .env on your laptop:
#    copy .env.laptop .env
# 2. Add the following line to your Windows hosts file (C:\Windows\System32\drivers\etc\hosts):
#    127.0.0.1 api.gst.local keycloak.gst.local minio.gst.local
# 3. Access locally on https://api.gst.local
#
# -------------------------------------------------------------------------
# INSTRUCTIONS FOR PUBLIC TESTING (SHARE WITH YOUR SIR):
# 1. Copy this file to .env:
#    copy .env.laptop .env
# 2. Start your Docker containers on the laptop:
#    docker compose up -d --build
# 3. Start the Cloudflare Tunnel in a terminal:
#    ..\cloudflared.exe tunnel --url http://localhost:8002 --no-autoupdate
# 4. Copy the "https://*.trycloudflare.com" URL printed in the terminal.
# 5. Set that URL as VITE_API_URL in the Vercel dashboard and redeploy.
# 6. Anyone (including your Sir) can now open the Vercel link and test it!
# =========================================================================

# -------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------------------
POSTGRES_MAIN_DB=gst_recon
POSTGRES_MAIN_USER=gstadmin
POSTGRES_MAIN_PASSWORD=GstAdmin123

POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=Keycloak123

# -------------------------------------------------------------------------
# KEYCLOAK CONFIGURATION
# -------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=Admin123
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gsttool
KEYCLOAK_CLIENT_ID=admin-api
KEYCLOAK_CLIENT_SECRET=admin-api-secret-change-in-production
KEYCLOAK_PUBLIC_KEY=

# -------------------------------------------------------------------------
# STORAGE CONFIGURATION (MINIO)
# -------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=MinioAdmin123
MINIO_DEFAULT_BUCKETS=gst-documents,gst-exports,gst-temp

# -------------------------------------------------------------------------
# NATS CONFIGURATION (MESSAGE QUEUE)
# -------------------------------------------------------------------------
NATS_URL=nats://nats:4222

# -------------------------------------------------------------------------
# SECURITY SECRETS
# -------------------------------------------------------------------------
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# -------------------------------------------------------------------------
# DOMAIN & SSL CONFIGURATION
# -------------------------------------------------------------------------
API_DOMAIN=api.gst.local
KEYCLOAK_DOMAIN=keycloak.gst.local
MINIO_DOMAIN=minio.gst.local
ACME_EMAIL=admin@gst.local

# Point this to your Vercel URL
FRONTEND_URL=https://adeskgst.vercel.app

# -------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# -------------------------------------------------------------------------
MOCK_ADESK_URL=http://localhost:3002
PLATFORM_NAME=GST TOOL
