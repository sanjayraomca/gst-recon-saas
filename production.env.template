# =========================================================================
# GST Tool Production Environment Configuration (Mac Mini / Ubuntu Server)
# =========================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to /opt/gsttool/gst-recon-saas/.env on your Mac Mini.
# 2. Replace all <YOUR_DOMAIN> placeholders with your actual domain (e.g. gsttool.com).
# 3. Change all passwords to strong, unique values.
# 4. Generate a unique JWT_SECRET (e.g. run `openssl rand -hex 32` in bash).
#
# =========================================================================

# -------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------------------
# Main Application Database (Postgres)
POSTGRES_MAIN_DB=gst_recon
POSTGRES_MAIN_USER=gstadmin
POSTGRES_MAIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD_HERE

# Keycloak Database (Postgres)
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD_HERE

# -------------------------------------------------------------------------
# KEYCLOAK CONFIGURATION
# -------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD_HERE
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gsttool
KEYCLOAK_CLIENT_ID=admin-api

# The KEYCLOAK_CLIENT_SECRET MUST match the secret defined in the imported
# realm JSON (infra/keycloak/gsttool-realm.json). If you didn't edit the json,
# the default value is 'admin-api-secret-change-in-production'.
KEYCLOAK_CLIENT_SECRET=admin-api-secret-change-in-production

# Cryptographic token validation key (RS256). You can leave this blank initially
# for automatic JWT fallback validation or paste the Keycloak Realm Public Key.
KEYCLOAK_PUBLIC_KEY=

# -------------------------------------------------------------------------
# STORAGE CONFIGURATION (MINIO)
# -------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD_HERE
MINIO_DEFAULT_BUCKETS=gst-documents,gst-exports,gst-temp

# -------------------------------------------------------------------------
# NATS CONFIGURATION (MESSAGE QUEUE)
# -------------------------------------------------------------------------
NATS_URL=nats://nats:4222

# -------------------------------------------------------------------------
# SECURITY SECRETS
# -------------------------------------------------------------------------
# Generate a secure random string using `openssl rand -hex 32`
JWT_SECRET=CHOOSE_A_SECURE_JWT_SECRET_STRING_HERE
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# -------------------------------------------------------------------------
# PRODUCTION DOMAIN & SSL CONFIGURATION (Traefik Entrypoints)
# -------------------------------------------------------------------------
# The domain where your backend is hosted (pointed to your Mac Mini Public IP)
API_DOMAIN=api.<YOUR_DOMAIN>
KEYCLOAK_DOMAIN=auth.<YOUR_DOMAIN>
MINIO_DOMAIN=storage.<YOUR_DOMAIN>

# Email address for Let's Encrypt renewal warnings & SSL certificate issues
ACME_EMAIL=admin@<YOUR_DOMAIN>

# The exact URL of your Vercel deployment (used for CORS allowlists & redirects)
FRONTEND_URL=https://<YOUR_VERCEL_APP_SUBDOMAIN>.vercel.app
# If you have a custom domain on Vercel:
# FRONTEND_URL=https://app.<YOUR_DOMAIN>

# -------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# -------------------------------------------------------------------------
MOCK_ADESK_URL=http://localhost:3002
PLATFORM_NAME=GST TOOL
