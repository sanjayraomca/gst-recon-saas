{
  "info": {
    "_postman_id": "ext-gst-api-collection",
    "name": "External GST Integration API",
    "description": "API collection for the External GST Integration Service. Covers client registration, GSTIN management, taxpayer search, return tracking, and OTP authentication.\n\n**Base URL**: http://localhost:3008\n\n**How to use:**\n1. Run `POST Register API Client` — copy the `api_key` from the response\n2. Paste it into the `X-API-Key` collection variable\n3. Run all other requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3008",
      "description": "Base URL of the External GST API Service"
    },
    {
      "key": "apiKey",
      "value": "",
      "description": "Your API Key — paste here after running Register API Client"
    },
    {
      "key": "gstin",
      "value": "33AAGCB1286Q1ZB",
      "description": "Test GSTIN (TN sandbox account)"
    },
    {
      "key": "gstUsername",
      "value": "TN_NT2.152383",
      "description": "GST portal username for the test GSTIN"
    },
    {
      "key": "otpTxn",
      "value": "",
      "description": "Transaction ID returned by OTP Request — paste here before running Verify OTP"
    }
  ],
  "item": [
    {
      "name": "🔑 Client Management",
      "description": "Register your app and manage GSTINs",
      "item": [
        {
          "name": "Register API Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data?.api_key) {",
                  "    pm.collectionVariables.set('apiKey', res.data.api_key);",
                  "    console.log('✅ API Key saved to collection variable:', res.data.api_key);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact_email\": \"admin@mybilling.com\",\n  \"platform\": \"My Billing Software\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ext/gst/clients",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "clients"]
            },
            "description": "Register a new API client. Returns a 64-character `api_key`.\n\n**No API key required for this endpoint.**\n\nThe test script auto-saves the returned `api_key` to the collection variable."
          },
          "response": [
            {
              "name": "Success - Client Registered",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"API client registered. Store your api_key safely — it will not be shown again.\",\n  \"data\": {\n    \"id\": \"0721ed7e-9ce8-4163-9fe4-8e12fbcb5328\",\n    \"platform\": \"My Billing Software\",\n    \"client_name\": \"My Billing Software\",\n    \"contact_email\": \"admin@mybilling.com\",\n    \"api_key\": \"d8edce85388a4ee6be000b5567f15e02388782566255454d94deed4ce7c61241\",\n    \"created_at\": \"2026-05-20T10:43:02.043Z\"\n  }\n}"
            },
            {
              "name": "Error - Missing Fields",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"error\": \"contact_email and platform are required.\"\n}"
            }
          ]
        },
        {
          "name": "Register GSTIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "description": "Your API Key"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gstin\": \"{{gstin}}\",\n  \"gst_username\": \"{{gstUsername}}\",\n  \"state_code\": \"33\",\n  \"legal_name\": \"WhiteBooks Technology Pvt Ltd\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ext/gst/clients/gstins",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "clients", "gstins"]
            },
            "description": "Register a GSTIN under your API client account.\n\nYou can register multiple GSTINs. Only registered GSTINs can use the OTP/auth flow.\n\n**Required header:** `X-API-Key`"
          },
          "response": [
            {
              "name": "Success - GSTIN Registered",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"GSTIN registered.\",\n  \"data\": {\n    \"id\": \"9a90a3c5-8aa5-465e-b491-28c2d8129ab7\",\n    \"gstin\": \"33AAGCB1286Q1ZB\",\n    \"gst_username\": \"TN_NT2.152383\",\n    \"state_code\": \"33\",\n    \"legal_name\": \"WhiteBooks Technology Pvt Ltd\",\n    \"created_at\": \"2026-05-20T10:43:13.230Z\"\n  }\n}"
            },
            {
              "name": "Error - Invalid GSTIN Format",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"error\": \"Invalid GSTIN format.\"\n}"
            },
            {
              "name": "Error - Already Registered",
              "status": "Conflict",
              "code": 409,
              "body": "{\n  \"success\": false,\n  \"error\": \"This GSTIN is already registered for your account.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "🌐 Public GST APIs",
      "description": "No OTP required. Calls White Book /public/* endpoints.",
      "item": [
        {
          "name": "Search Taxpayer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ext/gst/search?gstin={{gstin}}",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "search"],
              "query": [
                {
                  "key": "gstin",
                  "value": "{{gstin}}",
                  "description": "15-character GSTIN of the taxpayer"
                }
              ]
            },
            "description": "Search taxpayer details by GSTIN.\n\n**Cached for 24 hours.** Response includes `\"source\": \"live\"` or `\"source\": \"cache\"`.\n\nData returned:\n- Legal name, trade name\n- Registration type (Regular/Composition etc.)\n- Status (Active/Cancelled)\n- Address, jurisdiction\n- Business nature"
          },
          "response": [
            {
              "name": "Success - Live from White Book",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"source\": \"live\",\n  \"data\": {\n    \"data\": {\n      \"gstin\": \"33AAGCB1286Q1ZB\",\n      \"lgnm\": \"WhiteBooks\",\n      \"tradeNam\": \"GSTN\",\n      \"dty\": \"Regular\",\n      \"sts\": \"Active\",\n      \"rgdt\": \"01/07/2017\",\n      \"stj\": \"ADYAR\",\n      \"nba\": [\"Export\"],\n      \"pradr\": {\n        \"addr\": {\n          \"bnm\": \"Gold Hill Supreme\",\n          \"bno\": \"252\",\n          \"loc\": \"Electronic City Phase 2\",\n          \"stcd\": \"Tamil Nadu\",\n          \"pncd\": \"600123\"\n        },\n        \"ntr\": \"Export\"\n      },\n      \"einvoiceStatus\": \"No\"\n    },\n    \"status_cd\": \"1\",\n    \"status_desc\": \"Public API Search Taxpayer Success\"\n  }\n}"
            },
            {
              "name": "Success - Served from Cache",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"source\": \"cache\",\n  \"data\": { ... }\n}"
            },
            {
              "name": "Error - Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"success\": false,\n  \"error\": \"Taxpayer not found.\"\n}"
            },
            {
              "name": "Error - Missing API Key",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"error\": \"Missing API key. Include X-API-Key header.\"\n}"
            }
          ]
        },
        {
          "name": "Track Return Filing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ext/gst/rettrack?gstin={{gstin}}&fy=2023-24&type=R1",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "rettrack"],
              "query": [
                {
                  "key": "gstin",
                  "value": "{{gstin}}",
                  "description": "GSTIN of the taxpayer"
                },
                {
                  "key": "fy",
                  "value": "2023-24",
                  "description": "Financial Year in YYYY-YY format"
                },
                {
                  "key": "type",
                  "value": "R1",
                  "description": "Return type: R1, 3B, R6, R9, IFF etc. Leave empty for all.",
                  "disabled": false
                }
              ]
            },
            "description": "Track return filing status for a GSTIN across a Financial Year.\n\n**Cached per client for 6 hours.**\n\nResponse shows filing history — which months are filed, pending, or not required."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"source\": \"live\",\n  \"data\": {\n    \"status_cd\": \"1\",\n    \"EFiledlist\": [...]\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Preferences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ext/gst/preferences?gstin={{gstin}}&fy=2023-24",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "preferences"],
              "query": [
                {
                  "key": "gstin",
                  "value": "{{gstin}}"
                },
                {
                  "key": "fy",
                  "value": "2023-24",
                  "description": "Financial Year YYYY-YY"
                }
              ]
            },
            "description": "Fetch taxpayer's filing preference settings (e.g., quarterly vs monthly filer, IFF preference) for a given financial year."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔐 GST Portal Authentication",
      "description": "OTP-based login flow for authenticated GSTN APIs. Step 1 → Request OTP. Step 2 → Verify OTP. Session stored automatically.",
      "item": [
        {
          "name": "Step 1 — Request OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.txn) {",
                  "    pm.collectionVariables.set('otpTxn', res.txn);",
                  "    console.log('✅ OTP TXN saved:', res.txn);",
                  "} else {",
                  "    console.log('ℹ️ OTP sent. txn is null in sandbox (use hardcoded txn for Step 2).');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gstin\": \"{{gstin}}\",\n  \"gst_username\": \"{{gstUsername}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ext/gst/auth/otp-request",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "auth", "otp-request"]
            },
            "description": "Initiates OTP dispatch to the registered mobile and email of the GST username.\n\n**Requirements:**\n- GSTIN must be registered via `POST /ext/gst/clients/gstins` first\n- Default sandbox OTP is always **`123456`**\n\nThe `txn` in the response is saved automatically to `{{otpTxn}}`."
          },
          "response": [
            {
              "name": "Success - OTP Sent",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"OTP sent to registered mobile and email of the GST username.\",\n  \"txn\": \"TXNID12345\"\n}"
            },
            {
              "name": "Error - GSTIN Not Registered",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"success\": false,\n  \"error\": \"This GSTIN is not registered for your API key. Register it first via POST /ext/gst/clients/gstins\"\n}"
            }
          ]
        },
        {
          "name": "Step 2 — Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gstin\": \"{{gstin}}\",\n  \"gst_username\": \"{{gstUsername}}\",\n  \"otp\": \"123456\",\n  \"txn\": \"{{otpTxn}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ext/gst/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "auth", "verify-otp"]
            },
            "description": "Verifies the OTP and stores the auth session for the GSTIN in the database.\n\nThe auth token is reused automatically for all subsequent authenticated calls — no need to pass it in future requests.\n\n**Sandbox OTP:** always `123456`\n\n**`txn`** — use value from Step 1 response (auto-filled via `{{otpTxn}}`)."
          },
          "response": [
            {
              "name": "Success - Session Stored",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Authentication successful. Session stored and will be reused automatically.\"\n}"
            },
            {
              "name": "Error - Invalid OTP",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"error\": \"Invalid OTP or expired transaction.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "🛡️ Auth Middleware Tests",
      "description": "Tests to verify API key security is working",
      "item": [
        {
          "name": "No API Key (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ext/gst/search?gstin={{gstin}}",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "search"],
              "query": [{ "key": "gstin", "value": "{{gstin}}" }]
            },
            "description": "Should return 401 — no X-API-Key header sent."
          },
          "response": [
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"error\": \"Missing API key. Include X-API-Key header.\"\n}"
            }
          ]
        },
        {
          "name": "Invalid API Key (expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "INVALID_KEY_12345"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ext/gst/search?gstin={{gstin}}",
              "host": ["{{baseUrl}}"],
              "path": ["ext", "gst", "search"],
              "query": [{ "key": "gstin", "value": "{{gstin}}" }]
            },
            "description": "Should return 401 — key is not in the database."
          },
          "response": [
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"error\": \"Invalid or inactive API key.\"\n}"
            }
          ]
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Service health check — no auth required."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"UP\",\n  \"service\": \"external-api-service\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
