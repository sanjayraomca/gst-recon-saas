# ============================================
# DATABASE CONFIGURATION
# ============================================

# Main Database (Postgres)
POSTGRES_MAIN_DB=gst_recon
POSTGRES_MAIN_USER=gstadmin
POSTGRES_MAIN_PASSWORD=GstAdmin123

# Keycloak Database
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=Keycloak123

# Kong Database
POSTGRES_KONG_DB=kong
POSTGRES_KONG_USER=kong
POSTGRES_KONG_PASSWORD=Kong123

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=Admin123
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gsttool
KEYCLOAK_CLIENT_ID=admin-api
KEYCLOAK_CLIENT_SECRET=admin-api-secret-change-in-production

# ============================================
# STORAGE CONFIGURATION (MINIO)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=MinioAdmin123
MINIO_DEFAULT_BUCKETS=gst-documents,gst-exports,gst-temp

# ============================================
# NATS CONFIGURATION
# ============================================
NATS_URL=nats://nats:4222

# ============================================
# SERVICE SECRETS
# ============================================
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# ============================================
# ADESK CONNECTOR CONFIGURATION
# ============================================
# Base URL for internal mock Adesk server (used when cloudUrl contains "mock-adesk")
MOCK_ADESK_URL=http://localhost:3002
# Platform name sent in third-party-platform header to Adesk API
PLATFORM_NAME=GST TOOl
