# ============================================
# DATABASE CONFIGURATION
# ============================================

# Main Database (Postgres)
POSTGRES_MAIN_DB=gst_recon
POSTGRES_MAIN_USER=gstadmin
POSTGRES_MAIN_PASSWORD=CHANGE_ME_strong_db_password

# Keycloak Database
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=CHANGE_ME_strong_keycloak_db_password

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_keycloak_admin_password
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gsttool
KEYCLOAK_CLIENT_ID=admin-api
# Regenerate in Keycloak admin console: Clients > admin-api > Credentials > Regenerate
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_keycloak_admin_api_client_secret

# ============================================
# STORAGE CONFIGURATION (MINIO)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_DEFAULT_BUCKETS=gst-documents,gst-exports,gst-temp

# ============================================
# NATS CONFIGURATION
# ============================================
NATS_URL=nats://nats:4222

# ============================================
# SERVICE SECRETS & SECURITY
# ============================================
# REQUIRED (min 32 chars). Signs third-party org_access_tokens. tenant/workspace services refuse to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# REQUIRED. Keycloak realm public key used to verify every access token (RS256).
# If blank, ALL authenticated API requests are rejected (there is no "skip verification" mode).
# Get it from the "public_key" field of: http://<KEYCLOAK_HOST>/realms/gsttool
#   e.g. curl -s http://localhost:8080/realms/gsttool | node -e "process.stdin.on('data',d=>console.log(JSON.parse(d).public_key))"
KEYCLOAK_PUBLIC_KEY=

# REQUIRED (min 32 chars). Encrypts stored GSTN portal passwords. workspace/gstn services refuse to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it later requires scripts/reencrypt_gstn_passwords.js
GSTN_ENCRYPTION_KEY=CHANGE_ME

# Used only by seed-superadmin.js to create the platform super admin (no defaults in code)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ============================================
# PRODUCTION DOMAIN & SSL CONFIGURATION
# ============================================
API_DOMAIN=api.example.com
KEYCLOAK_DOMAIN=auth.example.com
MINIO_DOMAIN=storage.example.com
ACME_EMAIL=admin@example.com
FRONTEND_URL=https://myfrontend.vercel.app

# ============================================
# ADESK CONNECTOR CONFIGURATION
# ============================================
# Base URL for internal mock Adesk server (used when cloudUrl contains "mock-adesk")
MOCK_ADESK_URL=http://localhost:3002
# Platform name sent in third-party-platform header to Adesk API
PLATFORM_NAME=GST TOOl

# ---- Google reCAPTCHA (sign-up page) ----
# The secret key pairs with VITE_RECAPTCHA_SITE_KEY in recon_frontend/.env.production.
# Get a real pair at https://www.google.com/recaptcha/admin (type: v2 "I'm not a robot"),
# adding your domain(s) and localhost. The values below are Google's public TEST pair:
# the widget always passes and shows a red "for testing purposes only" notice.
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Only for local dev with no keys at all. Never true in production.
RECAPTCHA_DISABLED=false
