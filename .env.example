# Environment Variables Configuration Template
# Copy this file to .env and update with your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres-main
DB_PORT=5432
DB_NAME=gst_recon
DB_USER=gstadmin
DB_PASSWORD=CHANGE_ME

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gsttool
KEYCLOAK_CLIENT_ID=admin-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ============================================
# NATS CONFIGURATION
# ============================================
NATS_URL=nats://nats:4222

# ============================================
# SERVICE PORTS
# ============================================
TENANT_SERVICE_PORT=3001
WORKSPACE_SERVICE_PORT=3002
GSTN_SERVICE_PORT=3003
UPLOAD_SERVICE_PORT=3004
REPORT_SERVICE_PORT=3005

# ============================================
# TRAEFIK CONFIGURATION
# ============================================
TRAEFIK_DASHBOARD_PORT=8085
TRAEFIK_HTTP_PORT=8088

# ============================================
# POSTGRES CONFIGURATION (FOR PG SERVICE)
# ============================================
POSTGRES_USER=gstadmin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=gst_recon

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=CHANGE_ME
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
