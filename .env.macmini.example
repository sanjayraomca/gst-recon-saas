# Mac Mini production .env — copy to /opt/gsttool/gst-recon-saas/.env
# Replace <...> values. Nothing else in the repo changes.
POSTGRES_MAIN_DB=gst_main
POSTGRES_MAIN_USER=gst_user
POSTGRES_MAIN_PASSWORD=CHANGE_ME_STRONG
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=CHANGE_ME_STRONG
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG
KEYCLOAK_REALM=gsttool
KEYCLOAK_CLIENT_ID=admin-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_MATCH_REALM
KEYCLOAK_URL=http://keycloak:8080
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
API_DOMAIN=api.example.com
KEYCLOAK_DOMAIN=auth.example.com
MINIO_DOMAIN=storage.example.com
ACME_EMAIL=you@example.com
FRONTEND_URL=https://adeskgst.vercel.app
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
MINIO_DEFAULT_BUCKETS=gst-uploads
MOCK_ADESK_URL=http://localhost:3002
EXT_API_URL=http://gsp_api_app:4015
